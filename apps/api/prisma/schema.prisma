// Event Invitation & QR Ticket Platform – database schema.
//
// Conventions
//  • snake_case tables/columns in PostgreSQL, camelCase in the Prisma client.
//  • UUID primary keys (never sequential → nothing guessable leaks into URLs).
//  • The target PostgreSQL schema comes from `?schema=` in DATABASE_URL
//    (`app` on Supabase, so tables stay out of the API-exposed `public` schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZER
  SCANNER
}

enum MembershipRole {
  OWNER
  MEMBER
  SCANNER
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  REVOKED
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum EmailKind {
  INVITATION
  RESEND
}

enum ScanResult {
  ADMITTED
  ALREADY_USED
  REVOKED
  WRONG_EVENT
  INVALID
  EXPIRED
  EVENT_NOT_ACTIVE
  EVENT_ENDED
  CAPACITY_REACHED
}

enum ScanMethod {
  QR
  MANUAL
}

// ── Identity ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     OrganizerMembership[]
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  eventStaff      EventStaff[]
  scannedTickets  Ticket[]              @relation("TicketScannedBy")
  scanLogs        ScanLog[]
  emailDeliveries EmailDelivery[]
  auditLogs       AuditLog[]

  @@map("users")
}

/// One login session. The refresh token is stored only as a SHA-256 hash and
/// rotated on every use; `familyId` links all rotations of one login so that
/// reuse of an old token revokes the whole family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Tenancy ─────────────────────────────────────────────────────────────────

/// The tenant. Every event and every guest belongs to exactly one organizer.
model Organizer {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  contactEmail  String?  @map("contact_email")
  /// Shown on the guest's ticket. Path under /uploads/logos.
  logoUrl       String?  @map("logo_url")
  /// Guest personal data is anonymized this many days after their last event
  /// ended. 0 disables automatic anonymization.
  retentionDays Int      @default(365) @map("retention_days")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizerMembership[]
  events      Event[]
  guests      Guest[]
  auditLogs   AuditLog[]

  @@map("organizers")
}

model OrganizerMembership {
  id          String         @id @default(uuid()) @db.Uuid
  organizerId String         @map("organizer_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerId, userId])
  @@index([userId])
  @@map("organizer_memberships")
}

// ── Events ──────────────────────────────────────────────────────────────────

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  organizerId     String      @map("organizer_id") @db.Uuid
  name            String
  description     String?
  startsAt        DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?   @map("ends_at") @db.Timestamptz(3)
  venueName       String      @map("venue_name")
  venueAddress    String?     @map("venue_address")
  coverImageUrl   String?     @map("cover_image_url")
  status          EventStatus @default(DRAFT)
  capacity        Int?
  /// When true, check-ins beyond `capacity` are rejected (atomically).
  enforceCapacity Boolean     @default(false) @map("enforce_capacity")
  /// Denormalized counter, incremented in the same transaction as a check-in.
  /// It is what makes the capacity limit enforceable without a race.
  checkedInCount  Int         @default(0) @map("checked_in_count")
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer       Organizer       @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  staff           EventStaff[]
  ticketTypes     TicketType[]
  eventGuests     EventGuest[]
  tickets         Ticket[]
  emailDeliveries EmailDelivery[]
  scanLogs        ScanLog[]

  @@index([organizerId, startsAt])
  @@index([status])
  @@map("events")
}

/// Event-specific scanner permission: a SCANNER may only work on events
/// listed here.
model EventStaff {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_staff")
}

model TicketType {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  name         String
  description  String?
  capacity     Int?
  color        String   @default("#64748B")
  instructions String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventGuests EventGuest[]
  tickets     Ticket[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

// ── Guests ──────────────────────────────────────────────────────────────────

/// A person in ONE organizer's address book. Scoping by organizer means two
/// organizers can each have a guest with the same e-mail without ever seeing
/// each other's data.
model Guest {
  id           String    @id @default(uuid()) @db.Uuid
  organizerId  String    @map("organizer_id") @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String
  phone        String?
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer   Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  eventGuests EventGuest[]
  tickets     Ticket[]

  @@unique([organizerId, email])
  @@map("guests")
}

/// A guest's invitation to one event: which ticket type and how many tickets
/// the organizer allocated. Tickets are generated from this allocation.
model EventGuest {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  guestId        String   @map("guest_id") @db.Uuid
  ticketTypeId   String   @map("ticket_type_id") @db.Uuid
  ticketQuantity Int      @default(1) @map("ticket_quantity")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest           Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  ticketType      TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets         Ticket[]
  emailDeliveries EmailDelivery[]

  @@unique([eventId, guestId])
  @@index([guestId])
  @@index([ticketTypeId])
  @@map("event_guests")
}

// ── Tickets ─────────────────────────────────────────────────────────────────

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  guestId      String       @map("guest_id") @db.Uuid
  eventGuestId String       @map("event_guest_id") @db.Uuid
  ticketTypeId String       @map("ticket_type_id") @db.Uuid
  /// Human-readable reference printed on the ticket (NOT a credential).
  reference    String       @unique
  /// SHA-256 of the secret token carried by the QR code. The plaintext token
  /// is never stored.
  tokenHash    String       @unique @map("token_hash")
  /// AES-256-GCM ciphertext of the token (key lives outside the database).
  /// Only used to rebuild the ticket link for authorized re-sending.
  tokenCipher  String       @map("token_cipher")
  status       TicketStatus @default(VALID)
  expiresAt    DateTime?    @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?    @map("used_at") @db.Timestamptz(3)
  scannedById  String?      @map("scanned_by_id") @db.Uuid
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventGuest EventGuest @relation(fields: [eventGuestId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  scannedBy  User?      @relation("TicketScannedBy", fields: [scannedById], references: [id], onDelete: SetNull)
  scanLogs   ScanLog[]

  @@index([eventId, status])
  @@index([eventGuestId])
  @@index([guestId])
  @@index([ticketTypeId])
  @@index([eventId, usedAt])
  @@map("tickets")
}

// ── E-mail ──────────────────────────────────────────────────────────────────

/// One e-mail send (an invitation or a re-send) to one guest of one event.
/// A re-send creates a new row but NEVER new tickets.
model EmailDelivery {
  id                String      @id @default(uuid()) @db.Uuid
  eventId           String      @map("event_id") @db.Uuid
  eventGuestId      String      @map("event_guest_id") @db.Uuid
  kind              EmailKind   @default(INVITATION)
  toEmail           String      @map("to_email")
  subject           String
  status            EmailStatus @default(QUEUED)
  /// `<requestId>:<eventGuestId>` – a repeated HTTP request cannot enqueue
  /// the same e-mail twice.
  idempotencyKey    String      @unique @map("idempotency_key")
  providerMessageId String?     @unique @map("provider_message_id")
  attempts          Int         @default(0)
  lastError         String?     @map("last_error")
  ticketCount       Int         @default(0) @map("ticket_count")
  createdById       String?     @map("created_by_id") @db.Uuid
  queuedAt          DateTime    @default(now()) @map("queued_at") @db.Timestamptz(3)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?   @map("delivered_at") @db.Timestamptz(3)
  bouncedAt         DateTime?   @map("bounced_at") @db.Timestamptz(3)
  failedAt          DateTime?   @map("failed_at") @db.Timestamptz(3)
  complainedAt      DateTime?   @map("complained_at") @db.Timestamptz(3)
  /// Timestamp of the newest provider event applied (out-of-order guard).
  lastEventAt       DateTime?   @map("last_event_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventGuest EventGuest @relation(fields: [eventGuestId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([eventGuestId, queuedAt])
  @@map("email_deliveries")
}

/// Processed provider webhook ids – makes webhook handling idempotent.
model WebhookEvent {
  id         String   @id
  provider   String
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("webhook_events")
}

// ── Audit ───────────────────────────────────────────────────────────────────

/// Every scan attempt (successful or not). Deliberately free of guest
/// personal data, so it survives guest anonymization.
model ScanLog {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  ticketId  String?    @map("ticket_id") @db.Uuid
  scannerId String     @map("scanner_id") @db.Uuid
  result    ScanResult
  method    ScanMethod @default(QR)
  reason    String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket  Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  scanner User    @relation(fields: [scannerId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([scannerId, createdAt])
  @@index([ticketId])
  @@map("scan_logs")
}

/// Administrative actions (revocations, re-sends, link reveals, exports …).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  organizerId String?  @map("organizer_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organizer Organizer? @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
