# Copy to `.env` in the repository root and fill in the values.
# Never commit the real `.env`.

NODE_ENV=development
PORT=3000

# ── Database (Supabase) ─────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL  = "Transaction pooler" (port 6543) – used by the running app.
# DIRECT_URL    = "Session pooler" or direct connection (port 5432) – used by
#                 Prisma migrations.
# `schema=app` keeps all tables OUT of the `public` schema, so Supabase's
# auto-generated Data API (PostgREST / anon key) cannot reach guest data.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&schema=app"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app"

# Local alternative (docker compose postgres on port 5433):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/event_platform?schema=app"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/event_platform?schema=app"

# Integration tests wipe their database. They NEVER use DATABASE_URL –
# only this one. Keep it pointed at the local docker Postgres.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/event_platform?schema=test"

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Security ────────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
# AES-256-GCM key for ticket-link encryption. EXACTLY 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Manage separately from the database (secret manager). Losing it means
# existing ticket links can no longer be re-sent (tickets stay scannable).
TICKET_TOKEN_ENC_KEY=""
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Set to true behind HTTPS (always true in production).
COOKIE_SECURE=false
# Reverse proxies in front of the API: false | true (=1) | hop count. Netlify -> Railway = 2.
TRUST_PROXY=false

# ── URLs ────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGINS="http://localhost:5173,https://localhost:5173"
# Public base URL of the web app – used in ticket links, QR codes and e-mails.
PUBLIC_APP_URL="http://localhost:5173"
APP_TIMEZONE="Europe/Belgrade"

# ── E-mail ──────────────────────────────────────────────────────────────────
# mock   – no real e-mail leaves the machine; messages land in the dev
#          mailbox (Podešavanja → Test sanduče) and delivery is simulated.
# resend – real delivery through the Resend API.
# gmail  – real delivery through Gmail SMTP. EMAIL_FROM must hold the Gmail
#          address and EMAIL_APP_PASSWORD an app password for that account
#          (https://myaccount.google.com/apppasswords). No delivery webhooks.
EMAIL_MODE=mock
EMAIL_FROM="Pozivnice <pozivnice@example.com>"
EMAIL_APP_PASSWORD=""
RESEND_API_KEY=""
# Resend → Webhooks → signing secret (whsec_...). Endpoint: POST /api/webhooks/resend
RESEND_WEBHOOK_SECRET=""
# Attach each ticket's QR code as an inline image in the invitation.
EMAIL_EMBED_QR=true
# bullmq – background jobs through Redis (default)
# inline – send inside the request (tests / environments without Redis)
EMAIL_QUEUE_MODE=bullmq

# ── Files ───────────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
